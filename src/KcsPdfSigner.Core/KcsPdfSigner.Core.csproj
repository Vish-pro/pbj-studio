<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0" />
    <!-- pdfSweep 5.x ships only a net461 assembly; it runs on .NET 8 (verified by the smoke test). -->
    <PackageReference Include="itext.pdfsweep" Version="5.0.7" NoWarn="NU1701" />
    <PackageReference Include="PDFtoImage" Version="5.3.0" />
  </ItemGroup>

</Project>
