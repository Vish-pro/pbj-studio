<Window x:Class="KcsPdfSigner.App.Dialogs.TrustedCertificatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindow}"
        Title="Trusted Certificates" Width="620" Height="520" MinWidth="480" MinHeight="360"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,14,20,8">
            <StackPanel>
                <TextBlock Text="Certificates trusted for checking signatures" FontWeight="SemiBold" FontSize="15" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85"
                           Text="PB&amp;J Studio trusts the certificates in the Windows certificate store plus the ones listed here. Indian DSC signatures lead to a CCA India root, which Windows usually does not include, so they show 'validity unknown' until you add that root here. Download the root only from cca.gov.in and compare its thumbprint. This list is used by PB&amp;J Studio only; Windows is not changed." />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="20,6,20,0">
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6"
                       Text="No certificates added yet." />
            <ListBox x:Name="CertificateList" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnView">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="20,12,20,14" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add from file..." Padding="12,4" Click="OnAdd" />
            <Button DockPanel.Dock="Left" x:Name="ViewButton" Content="View" Width="80" Margin="10,0,0,0" Click="OnView" IsEnabled="False" />
            <Button DockPanel.Dock="Left" x:Name="RemoveButton" Content="Remove" Width="90" Margin="10,0,0,0" Click="OnRemove" IsEnabled="False" />
            <Button DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" IsDefault="True" Click="OnClose" />
        </DockPanel>
    </Grid>
</Window>
