<Window x:Class="KcsPdfSigner.App.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindow}"
        Title="PB&amp;J Studio" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" MinWidth="360" MaxWidth="640">
    <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
        <Grid Margin="20,18,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Path x:Name="Glyph" Style="{StaticResource IconPath}" Margin="0,2,14,0"
                  VerticalAlignment="Top" Visibility="Collapsed">
                <Path.LayoutTransform>
                    <ScaleTransform ScaleX="1.75" ScaleY="1.75" />
                </Path.LayoutTransform>
            </Path>

            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxWidth="540"
                       VerticalAlignment="Center" LineHeight="18" />

            <StackPanel x:Name="InputHost" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"
                        Visibility="Collapsed">
                <TextBox x:Name="InputText" />
                <PasswordBox x:Name="InputPassword" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="ButtonRow" Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,20,0,0" />
        </Grid>
    </Border>
</Window>
