<Window x:Class="KcsPdfSigner.App.Dialogs.PreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindow}"
        Title="Preferences" Width="560" Height="640" MinHeight="420" MinWidth="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0">
            <StackPanel Margin="22,16,22,16">

                <TextBlock Text="Startup and documents" FontWeight="SemiBold" FontSize="15" />
                <CheckBox x:Name="ReopenLastSession" Margin="0,10,0,0"
                          Content="Open PDFs from the last session when the app starts" />
                <CheckBox x:Name="PromptMultiple" Margin="0,8,0,0"
                          Content="Ask before closing the window when several documents are open" />
                <CheckBox x:Name="CreateLinks" Margin="0,8,0,0"
                          Content="Create links from web addresses (http, https, www) found in the text" />
                <CheckBox x:Name="DetectFields" Margin="0,8,0,0"
                          Content="Highlight form fields automatically when a document opens" />

                <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <CheckBox x:Name="SingleKey" Margin="0,10,0,0"
                          Content="Single-key tool shortcuts: V = Select, H = Hand, G = Snapshot" />
                <CheckBox x:Name="QuickActions" Margin="0,8,0,0"
                          Content="Show quick actions (Copy, Highlight, Search) after selecting text" />
                <CheckBox x:Name="WheelZoom" Margin="0,8,0,0"
                          Content="Zoom with the mouse wheel (without holding Ctrl)" />

                <TextBlock Text="Snapshot tool" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <CheckBox x:Name="FixedResolution" VerticalAlignment="Center"
                              Content="Use a fixed resolution of" />
                    <TextBox x:Name="Ppi" Width="64" Margin="10,0,8,0" VerticalContentAlignment="Center" />
                    <TextBlock Text="pixels per inch" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="OpenForMarkup" Margin="0,8,0,0"
                          Content="Also open each snapshot as a new one-page PDF for markup" />

                <TextBlock Text="Display" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Touch mode" VerticalAlignment="Center" Width="150" />
                    <ComboBox x:Name="TouchBox" Width="200">
                        <ComboBoxItem Content="Auto (when a touch screen is found)" />
                        <ComboBoxItem Content="Always on (larger interface)" />
                        <ComboBoxItem Content="Off" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Scale for screen" VerticalAlignment="Center" Width="150" />
                    <ComboBox x:Name="ScaleBox" Width="200">
                        <ComboBoxItem Content="Auto (follow Windows scale)" />
                        <ComboBoxItem Content="No scaling (100%)" />
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="Warnings" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <CheckBox x:Name="HideWarnings" Margin="0,10,0,0"
                          Content="Do not show edit warnings (before redacting or flattening a form)" />
                <Button x:Name="ResetWarnings" Content="Reset all warnings" HorizontalAlignment="Left"
                        Margin="0,10,0,0" Padding="14,4" Click="OnResetWarnings" />

                <TextBlock Text="Suggestions" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <CheckBox x:Name="ShowSuggestionsBox" Margin="0,10,0,0"
                          Content="Show suggestions under the toolbar (for example 'Reduce the file size?')" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Suggest a smaller file above" VerticalAlignment="Center" />
                    <TextBox x:Name="LargeFileBox" Width="64" Margin="10,0,8,0" VerticalContentAlignment="Center" />
                    <TextBlock Text="MB" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Reset suggestions" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,4"
                        Click="OnResetSuggestions"
                        ToolTip="Show again the suggestions you chose 'Don't show this again' for" />

                <TextBlock Text="Signature checks" FontWeight="SemiBold" FontSize="15" Margin="0,22,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Signatures are trusted through the Windows certificate store and the certificates you add here (for Indian DSC signatures: the CCA India root)." />
                <Button Content="Trusted certificates..." HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,4"
                        Click="OnTrustedCertificates" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,12,22,14">
            <Button Content="OK" Width="90" IsDefault="True" Click="OnOk" />
            <Button Content="Cancel" Width="90" Margin="10,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
