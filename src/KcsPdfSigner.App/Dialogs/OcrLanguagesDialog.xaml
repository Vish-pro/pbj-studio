<Window x:Class="KcsPdfSigner.App.Dialogs.OcrLanguagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindow}"
        Title="Scan Languages" Width="640" Height="600" MinWidth="500" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,14,20,8">
            <StackPanel>
                <TextBlock Text="Languages for reading scans (OCR)" FontWeight="SemiBold" FontSize="15" />
                <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.85" />
            </StackPanel>
        </Border>

        <ListBox x:Name="LanguageRows" Grid.Row="1" Margin="20,6,20,0" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ActionText}" Visibility="{Binding ActionVisibility}"
                                Width="90" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnRowAction" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel x:Name="DownloadPanel" Grid.Row="2" Margin="20,10,20,0" Visibility="Collapsed">
            <TextBlock x:Name="DownloadText" TextWrapping="Wrap" />
            <DockPanel Margin="0,6,0,0">
                <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="Cancel" Width="80" Margin="10,0,0,0" Click="OnCancelDownload" />
                <ProgressBar x:Name="DownloadProgress" Height="6" VerticalAlignment="Center" Minimum="0" Maximum="1" />
            </DockPanel>
        </StackPanel>

        <DockPanel Grid.Row="3" Margin="20,12,20,14" LastChildFill="False">
            <Button x:Name="AddFromFileButton" DockPanel.Dock="Left" Content="Add from a file..." Padding="12,4" Click="OnAddFromFile"
                    ToolTip="For a PC without internet: choose a .traineddata file copied from another PC" />
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Width="90" IsCancel="True" IsDefault="True" Click="OnClose" />
        </DockPanel>
    </Grid>
</Window>
