<Window x:Class="KcsPdfSigner.App.Dialogs.SendCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindow}"
        Title="Send check" Width="580" SizeToContent="Height" MinWidth="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="20,14,20,6">
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Checks what banks and portals look at before they accept a signed PDF. OK = fine, ! = look at this before sending." />
            </StackPanel>
        </Border>

        <StackPanel x:Name="ChecksPanel" Grid.Row="1" Margin="20,8,20,0" />

        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Faint}" BorderThickness="0,1,0,0" Margin="20,12,20,0" Padding="0,10,0,0">
            <TextBlock x:Name="VerdictText" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,14">
            <Button Content="Close" Width="90" IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
