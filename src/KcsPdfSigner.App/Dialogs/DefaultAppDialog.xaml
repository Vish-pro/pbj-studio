<Window x:Class="KcsPdfSigner.App.Dialogs.DefaultAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindow}"
        Title="Default PDF app" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22,18,22,16">
        <TextBlock Text="Make PB&amp;J Studio your default PDF app?" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="PDF files will then open here when you double-click them. After Yes, Windows opens its settings page: press 'Set default' there (Windows asks every app to do it this way)." />
        <CheckBox x:Name="DontAsk" Content="Don't ask me again" Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="YesButton" Content="Yes" Width="90" IsDefault="True" Click="OnYes" />
            <Button x:Name="NoButton" Content="Not now" Width="90" Margin="10,0,0,0" IsCancel="True" Click="OnNo" />
        </StackPanel>
    </StackPanel>
</Window>
