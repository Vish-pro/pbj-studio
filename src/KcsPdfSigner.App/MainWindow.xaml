<Window x:Class="KcsPdfSigner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:nav="clr-namespace:KcsPdfSigner.App.Navigation"
        Style="{StaticResource StudioWindow}"
        Title="PB&amp;J Studio" Height="720" Width="1200" MinWidth="900" MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" AllowDrop="True">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F4" Command="{Binding CloseTabCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Z" Command="{Binding UndoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Y" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="Z" Command="{Binding RedoCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding FindCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="G" Command="{Binding GoToPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding PreferencesCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad2" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Key="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="F11" Command="{Binding FullScreenCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ===================== Menu ===================== -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." InputGestureText="Ctrl+O" Command="{Binding OpenCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="RecentMenu" Header="Open _recent" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _as..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
                <MenuItem Header="_Close document" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Print..." InputGestureText="Ctrl+P" Command="{Binding PrintCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Print}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Send to _WhatsApp..." Command="{Binding SendWhatsAppCommand}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Command="{Binding FindCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Select _text tool" InputGestureText="V" Command="{Binding SelectToolCommand}" />
                <MenuItem Header="_Hand tool" InputGestureText="H" Command="{Binding HandToolCommand}" />
                <MenuItem Header="_Snapshot tool" InputGestureText="G" Command="{Binding SnapshotToolCommand}" />
                <Separator />
                <MenuItem Header="Pre_ferences..." InputGestureText="Ctrl+K" Command="{Binding PreferencesCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _in" InputGestureText="Ctrl+Plus" Command="{Binding ZoomInCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomIn}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Zoom _out" InputGestureText="Ctrl+Minus" Command="{Binding ZoomOutCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomOut}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Actual size" InputGestureText="Ctrl+1" Command="{Binding ActualSizeCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ActualSize}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fit _width" InputGestureText="Ctrl+2" Command="{Binding FitWidthCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitWidth}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fit _page" InputGestureText="Ctrl+0" Command="{Binding FitPageCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitPage}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Rotate view _clockwise" Command="{Binding RotateClockwiseCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateCw}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rotate view c_ounter-clockwise" Command="{Binding RotateCounterClockwiseCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateCcw}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="NavPaneMenuItem" Header="_Navigation pane" IsCheckable="True" IsChecked="True"
                          Click="OnToggleNavPane" />
                <MenuItem x:Name="ToolsPaneMenuItem" Header="_Tools pane" IsCheckable="True" IsChecked="True"
                          Click="OnToggleToolsPane" />
                <MenuItem Header="_Full screen" InputGestureText="F11" Command="{Binding FullScreenCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FullScreen}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Document">
                <MenuItem Header="_First page" InputGestureText="Home" Command="{Binding FirstPageCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.First}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Previous page" InputGestureText="PgUp" Command="{Binding PreviousPageCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PageUp}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Next page" InputGestureText="PgDn" Command="{Binding NextPageCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PageDown}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Last page" InputGestureText="End" Command="{Binding LastPageCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Last}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Go to page..." InputGestureText="Ctrl+G" Command="{Binding GoToPageCommand}" />
                <Separator />
                <MenuItem Header="P_roperties..." Command="{Binding DocumentPropertiesCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Info}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Sign">
                <MenuItem Header="_Multi-Sign (DSC)..." Click="OnOpenMultiSign">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.MultiSign}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="ToolsMenu" Header="_Tools" />
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Command="{Binding ShowShortcutsCommand}" />
                <MenuItem Header="_About PB&amp;J Studio" Command="{Binding AboutCommand}">
                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Info}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ===================== Toolbar ===================== -->
        <ToolBar x:Name="MainToolBar" DockPanel.Dock="Top" ToolBarTray.IsLocked="True">
            <Button Command="{Binding OpenCommand}" ToolTip="Open (Ctrl+O)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" />
            </Button>
            <Button Command="{Binding SaveCommand}" ToolTip="Save (Ctrl+S)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" />
            </Button>
            <Button Command="{Binding PrintCommand}" ToolTip="Print (Ctrl+P)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Print}" />
            </Button>
            <Separator />
            <Button Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}" />
            </Button>
            <Button Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}" />
            </Button>
            <Separator />
            <Button Command="{Binding PreviousPageCommand}" ToolTip="Previous page (PgUp)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PageUp}" />
            </Button>
            <Button Command="{Binding NextPageCommand}" ToolTip="Next page (PgDn)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PageDown}" />
            </Button>
            <TextBox x:Name="PageBox" Width="46" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                     ToolTip="Page number. Type a page and press Enter (Ctrl+G)."
                     KeyDown="OnPageBoxKeyDown" LostKeyboardFocus="OnPageBoxLostFocus" />
            <TextBlock x:Name="PageCountText" Text="/ 0" VerticalAlignment="Center" Margin="6,0,4,0" />
            <Separator />
            <Button Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl+Minus)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomOut}" />
            </Button>
            <Button Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl+Plus)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomIn}" />
            </Button>
            <ComboBox x:Name="ZoomBox" Width="96" IsEditable="True" Margin="4,0" ToolTip="Zoom"
                      SelectionChanged="OnZoomBoxSelectionChanged" KeyDown="OnZoomBoxKeyDown">
                <ComboBoxItem Content="10%" />
                <ComboBoxItem Content="25%" />
                <ComboBoxItem Content="50%" />
                <ComboBoxItem Content="75%" />
                <ComboBoxItem Content="100%" />
                <ComboBoxItem Content="125%" />
                <ComboBoxItem Content="150%" />
                <ComboBoxItem Content="200%" />
                <ComboBoxItem Content="300%" />
                <ComboBoxItem Content="400%" />
                <ComboBoxItem Content="800%" />
                <ComboBoxItem Content="Fit width" />
                <ComboBoxItem Content="Fit page" />
            </ComboBox>
            <Button Command="{Binding FitWidthCommand}" ToolTip="Fit width (Ctrl+2)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitWidth}" />
            </Button>
            <Button Command="{Binding FitPageCommand}" ToolTip="Fit page (Ctrl+0)">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitPage}" />
            </Button>
            <Button Command="{Binding RotateClockwiseCommand}" ToolTip="Rotate view clockwise">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateCw}" />
            </Button>
            <Separator />
            <Grid Width="200" Margin="2,0">
                <TextBox x:Name="FindBox" Padding="24,2,3,2" KeyDown="OnFindBoxKeyDown"
                         ToolTip="Find text (Ctrl+F), then Enter" />
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}" HorizontalAlignment="Left"
                      Margin="5,0,0,0" IsHitTestVisible="False" Opacity="0.7" />
                <TextBlock x:Name="FindHint" Text="Find" Margin="26,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" Opacity="0.5" />
            </Grid>
            <Separator />
            <ToggleButton x:Name="NavPaneToggle" IsChecked="True" ToolTip="Navigation pane" Click="OnToggleNavPane">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PanelLeft}" />
            </ToggleButton>
            <ToggleButton x:Name="ToolsPaneToggle" IsChecked="True" ToolTip="Tools pane" Click="OnToggleToolsPane">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PanelRight}" />
            </ToggleButton>
        </ToolBar>

        <!-- ===================== Status bar ===================== -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="BuiltByStatus" Text="Built by vistaar.space" Opacity="0.7" Margin="12,0,0,0" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="ZoomStatus" Text="" MinWidth="60" TextAlignment="Right" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="PageStatus" Text="" MinWidth="110" TextAlignment="Right" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="DirtyStatus" Text="" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- ===================== Body ===================== -->
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="230" MinWidth="0" />
                <ColumnDefinition x:Name="NavSplitterColumn" Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="ToolsSplitterColumn" Width="4" />
                <ColumnDefinition x:Name="ToolsColumn" Width="400" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <nav:NavigationPane x:Name="NavPane" Grid.Column="0" />

            <GridSplitter x:Name="NavSplitter" Grid.Column="1" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <TabControl x:Name="DocumentTabs" BorderThickness="0,1,0,0"
                            SelectionChanged="OnDocumentTabChanged" />
                <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.MultiSign}" Opacity="0.9">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="4" ScaleY="4" />
                        </Path.LayoutTransform>
                    </Path>
                    <TextBlock Text="PB&amp;J Studio" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Margin="0,16,0,6" />
                    <TextBlock Text="Open a PDF to view, edit and sign it at many places in one go."
                               HorizontalAlignment="Center" Opacity="0.75" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}"
                            HorizontalAlignment="Center" Margin="0,18,0,0" Padding="18,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Margin="0,0,8,0" />
                            <TextBlock Text="Open a PDF" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="or drop a PDF anywhere on this window" HorizontalAlignment="Center"
                               Opacity="0.6" Margin="0,10,0,0" FontSize="11" />
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="ToolsSplitter" Grid.Column="3" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- Right tools pane -->
            <Border x:Name="ToolsPane" Grid.Column="4" BorderBrush="{StaticResource Brush.Subtle}" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1"
                            Padding="6,6">
                        <DockPanel>
                            <Button x:Name="AllToolsButton" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                                    ToolTip="All tools" Click="OnShowAllTools" Margin="0,0,6,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronLeft}" />
                            </Button>
                            <Path x:Name="ToolHeaderIcon" DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                                  Data="{StaticResource Icon.Tools}" Margin="2,0,8,0" />
                            <TextBlock x:Name="ToolHeaderTitle" Text="Tools" Style="{StaticResource PaneTitle}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid>
                    <ListBox x:Name="ToolList" BorderThickness="0" Padding="8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="OnToolListClicked" KeyDown="OnToolListKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Card" BorderBrush="{StaticResource Brush.Faint}" BorderThickness="1"
                                        Padding="10,8">
                                    <DockPanel>
                                        <Path x:Name="CardIcon" DockPanel.Dock="Left" Style="{StaticResource IconPath}"
                                              Data="{Binding Icon}" Margin="0,0,12,0" VerticalAlignment="Top" />
                                        <StackPanel>
                                            <TextBlock x:Name="CardTitle" Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.75"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- The primary tool is drawn inverted and larger: the strongest entry. -->
                                    <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource Brush.Fg}" />
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.Fg}" />
                                        <Setter TargetName="Card" Property="Padding" Value="12,14" />
                                        <Setter TargetName="Card" Property="TextElement.Foreground" Value="{StaticResource Brush.Bg}" />
                                        <Setter TargetName="CardTitle" Property="FontSize" Value="15" />
                                        <Setter TargetName="CardTitle" Property="FontWeight" Value="Bold" />
                                        <Setter TargetName="CardIcon" Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ContentControl x:Name="ToolHost" Focusable="False" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
