<UserControl x:Class="KcsPdfSigner.App.Suggestions.SuggestionBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One suggestion: a thin bar with a message, one action, Dismiss and "Don't show this again". -->
    <Border BorderBrush="{StaticResource Brush.Faint}" BorderThickness="1" Margin="6,4,6,0" Padding="10,4">
        <DockPanel>
            <Button x:Name="NeverButton" DockPanel.Dock="Right" Content="Don't show this again" Padding="10,2"
                    Margin="6,0,0,0" VerticalAlignment="Center" Click="OnNever"
                    ToolTip="Stop showing this kind of suggestion (turn it back on with Preferences > Reset suggestions)" />
            <Button x:Name="DismissButton" DockPanel.Dock="Right" Content="Dismiss" Padding="10,2" Margin="6,0,0,0"
                    VerticalAlignment="Center" Click="OnDismiss" ToolTip="Hide it for this document" />
            <Button x:Name="ActionButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="12,2"
                    Margin="10,0,0,0" VerticalAlignment="Center" Click="OnAction" />
            <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Info}"
                  Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Border>
</UserControl>
