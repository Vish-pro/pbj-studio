<UserControl x:Class="KcsPdfSigner.App.Tools.EditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" Margin="12,4,12,12">
            <TextBlock x:Name="NoDocumentText" Text="Open a PDF to edit it." Style="{StaticResource Hint}" Margin="0,6,0,0" />

            <!-- Add text -->
            <TextBlock Text="Add text" Style="{StaticResource SectionHeading}" />
            <TextBox x:Name="AddTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                     VerticalScrollBarVisibility="Auto" />
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="TextSizeBox" Text="12" Width="48" />
                <ToggleButton x:Name="PlaceTextToggle" Content="Click to place" Margin="8,0,0,0"
                              HorizontalAlignment="Left" Click="OnPlaceTextToggled" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Type the text, press Click to place, then click on the page where the first line should start." />

            <!-- Add image -->
            <TextBlock Text="Add image" Style="{StaticResource SectionHeading}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse" Margin="6,0,0,0" Click="OnBrowseImage" />
                <TextBox x:Name="ImagePathBox" IsReadOnly="True" />
            </DockPanel>
            <ToggleButton x:Name="PlaceImageToggle" Content="Drag to place" Margin="0,6,0,0"
                          HorizontalAlignment="Left" Click="OnPlaceImageToggled" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Pick a PNG or JPEG, press Drag to place, then drag a box on the page. The image fills the box." />

            <!-- Watermark -->
            <TextBlock Text="Watermark" Style="{StaticResource SectionHeading}" />
            <TextBox x:Name="WatermarkText" Text="CONFIDENTIAL" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Opacity" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="5" Maximum="100" Value="30"
                        IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="Rotation" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox x:Name="RotationBox" Grid.Row="1" Grid.Column="1" Text="45" Margin="0,6,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="deg" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center" Margin="0,6,0,0" />
                <TextBox x:Name="WatermarkSizeBox" Grid.Row="2" Grid.Column="1" Text="60" Margin="0,6,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="pt" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,6,0,0" />
            </Grid>
            <Button Content="Add watermark to every page" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnWatermarkClicked" />

            <!-- Header and footer -->
            <TextBlock Text="Header, footer, page numbers" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="Header" Style="{StaticResource Hint}" />
            <TextBox x:Name="HeaderText" />
            <TextBlock Text="Footer" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            <TextBox x:Name="FooterText" />
            <CheckBox x:Name="PageNumbersCheck" Content="Page numbers (Page n of N, bottom right)" Margin="0,8,0,0" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Header and footer may use {page} and {pages}." />
            <Button Content="Add to every page" Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnHeaderFooterClicked" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
