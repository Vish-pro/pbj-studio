<UserControl x:Class="KcsPdfSigner.App.Tools.ScanCleanerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
            <TextBlock Text="Pictures" Style="{StaticResource SectionHeading}" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" TextWrapping="Wrap"
                       Text="Photos of pages (JPG, PNG, TIFF, BMP). Each becomes one clean A4 page. Drop pictures on the list to add them. Everything runs on this PC." />
            <WrapPanel>
                <Button Margin="0,0,6,6" Click="OnAddPictures">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Plus}" Margin="0,0,6,0" />
                        <TextBlock Text="Add pictures..." VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveButton" Margin="0,0,6,6" Click="OnRemove">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Trash}" Margin="0,0,6,0" />
                        <TextBlock Text="Remove" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpButton" Margin="0,0,6,6" Click="OnMoveUp" ToolTip="Move up">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PageUp}" />
                </Button>
                <Button x:Name="DownButton" Margin="0,0,6,6" Click="OnMoveDown" ToolTip="Move down">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.PageDown}" />
                </Button>
                <Button x:Name="ClearButton" Margin="0,0,6,6" Content="Clear" Click="OnClear" />
            </WrapPanel>

            <ListBox x:Name="PictureList" Height="150" SelectionMode="Extended" AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnSelectionChanged" Drop="OnDropped" DragOver="OnDragOver" KeyDown="OnListKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Margin="8,0,0,0" Opacity="0.7" FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Hint}" Margin="0,4,0,0" />

            <TextBlock Text="Before and after" Style="{StaticResource SectionHeading}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#40808080" BorderThickness="1" Height="210">
                    <Image x:Name="BeforeImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <Border Grid.Column="2" BorderBrush="#40808080" BorderThickness="1" Height="210" Background="White">
                    <Image x:Name="AfterImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
            <TextBlock x:Name="PreviewText" Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Select a picture to see the clean-up." />

            <TextBlock Text="Output" Style="{StaticResource SectionHeading}" />
            <StackPanel>
                <RadioButton x:Name="ColourRadio" Content="Colour (paper whitened)" IsChecked="True" Margin="0,2,0,4" Checked="OnOptionChanged" />
                <RadioButton x:Name="GreyRadio" Content="Grey" Margin="0,2,0,4" Checked="OnOptionChanged" />
                <RadioButton x:Name="BwRadio" Content="Black and white (crisp text, smallest file)" Margin="0,2,0,4" Checked="OnOptionChanged" />
            </StackPanel>

            <TextBlock Text="Clean-up" Style="{StaticResource SectionHeading}" />
            <CheckBox x:Name="EdgesCheck" Content="Find the page edges and flatten it" IsChecked="True" Margin="0,2,0,4" Click="OnOptionChanged"
                      ToolTip="Cuts the page out of the photo and corrects the slant of a photo taken at an angle." />
            <CheckBox x:Name="StraightenCheck" Content="Straighten tilted text" IsChecked="True" Margin="0,2,0,4" Click="OnOptionChanged" />
            <CheckBox x:Name="BackgroundCheck" Content="Whiten the paper, remove shadows" IsChecked="True" Margin="0,2,0,4" Click="OnOptionChanged" />
            <CheckBox x:Name="OcrCheck" Content="Make searchable (OCR)" Margin="0,8,0,4" Click="OnOcrChanged"
                      ToolTip="Adds an invisible text layer so the PDF can be searched and copied. Slower." />
            <StackPanel x:Name="OcrLanguagesPanel" Visibility="Collapsed" Margin="18,0,0,0">
                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Tick every language the pages are written in." />
                <ItemsControl x:Name="LanguageList" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2,0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Languages..." HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0" Click="OnLanguages" />
                <TextBlock x:Name="EngineText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="RunButton" Style="{StaticResource PrimaryButton}" Padding="14,5" Click="OnRun">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ScanClean}" Margin="0,0,6,0" />
                        <TextBlock Text="Make PDF..." VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel" Padding="14,5" Margin="8,0,0,0" Click="OnCancel" Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="ProgressText" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="ResultText" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock Text="Tips" Style="{StaticResource SectionHeading}" />
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Photograph the page on a darker table, in even light, with the whole page in view. A white page on a white table has no edge to find; the picture is then only straightened and cleaned. Check the result before you rely on it: very crumpled or curled pages are flattened only as far as their four corners allow." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
