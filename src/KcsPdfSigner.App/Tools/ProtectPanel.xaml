<UserControl x:Class="KcsPdfSigner.App.Tools.ProtectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">

            <Border BorderBrush="{StaticResource Brush.Faint}" BorderThickness="1" Padding="8,6" Margin="0,4,0,0">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}"
                          Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusLine" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel x:Name="EncryptSection">
                <TextBlock Text="Password to open" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Text="Leave blank to let anyone open the file (the permissions below still apply)." />
                <PasswordBox x:Name="OpenPasswordBox" Margin="0,4,0,0" PasswordChanged="OnPasswordChanged" />
                <TextBlock Text="Repeat" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <PasswordBox x:Name="OpenPasswordRepeatBox" PasswordChanged="OnPasswordChanged" />

                <TextBlock Text="Permissions password" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Needed to change the restrictions or remove protection. Leave blank to use the password to open." />
                <PasswordBox x:Name="OwnerPasswordBox" Margin="0,4,0,0" PasswordChanged="OnPasswordChanged" />
                <TextBlock Text="Repeat" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                <PasswordBox x:Name="OwnerPasswordRepeatBox" PasswordChanged="OnPasswordChanged" />

                <TextBlock Text="Allow" Style="{StaticResource SectionHeading}" />
                <CheckBox x:Name="AllowPrintBox" Content="Printing" IsChecked="True" Margin="0,2" />
                <CheckBox x:Name="AllowCopyBox" Content="Copying text and images" IsChecked="True" Margin="0,2" />
                <CheckBox x:Name="AllowModifyBox" Content="Changes, comments and form filling" IsChecked="True" Margin="0,2" />

                <TextBlock x:Name="ValidationText" Style="{StaticResource Hint}" Margin="0,8,0,0" />

                <Button x:Name="EncryptButton" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Padding="18,6"
                        Click="OnEncrypt">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Margin="0,0,8,0" />
                        <TextBlock Text="Encrypt (AES-256)" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="The change applies to the open document; save it to keep it. Ctrl+Z undoes it." />
            </StackPanel>

            <StackPanel x:Name="RemoveSection">
                <TextBlock Text="Remove protection" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Text="Writes an unprotected version. Needs the permissions password if the file has one." />
                <Button x:Name="RemoveButton" Content="Remove password" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Padding="14,5" Click="OnRemovePassword" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
