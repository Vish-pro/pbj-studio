<UserControl x:Class="KcsPdfSigner.App.Tools.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,4,12,12">
            <TextBlock x:Name="NoDocumentText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Text="Open a PDF to see its properties." />

            <StackPanel x:Name="Sections">
                <TextBlock Text="Document" Style="{StaticResource SectionHeading}" />
                <Grid x:Name="InfoGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <TextBlock Text="Description" Style="{StaticResource SectionHeading}" />
                <TextBlock Text="Title" Style="{StaticResource Hint}" />
                <TextBox x:Name="TitleBox" TextChanged="OnFieldChanged" />
                <TextBlock Text="Author" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <TextBox x:Name="AuthorBox" TextChanged="OnFieldChanged" />
                <TextBlock Text="Subject" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <TextBox x:Name="SubjectBox" TextChanged="OnFieldChanged" />
                <TextBlock Text="Keywords" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <TextBox x:Name="KeywordsBox" TextChanged="OnFieldChanged" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Apply" Padding="18,6"
                            Click="OnApply" />
                    <Button x:Name="ResetButton" Content="Reset" Margin="6,0,0,0" Click="OnReset" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Applies to the open document; save it to keep the change. Ctrl+Z undoes it." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
