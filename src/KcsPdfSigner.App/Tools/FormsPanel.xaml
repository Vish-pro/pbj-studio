<UserControl x:Class="KcsPdfSigner.App.Tools.FormsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Form fields" Style="{StaticResource SectionHeading}" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Text="Open a PDF to fill its form." TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FieldHost" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <WrapPanel>
                <Button x:Name="ApplyButton" Content="Apply values" Style="{StaticResource PrimaryButton}" Padding="14,5"
                        Margin="0,0,6,6" Click="OnApplyClicked" IsEnabled="False" />
                <Button x:Name="ResetButton" Content="Reset" Margin="0,0,6,6" Click="OnResetClicked" IsEnabled="False" />
                <Button x:Name="FlattenButton" Content="Flatten form" Margin="0,0,6,6" Click="OnFlattenClicked" IsEnabled="False" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                       Text="Apply writes the changed values into the working copy (Ctrl+Z undoes it). Flatten burns the values into the pages and removes the fields." />
        </StackPanel>
    </Grid>
</UserControl>
