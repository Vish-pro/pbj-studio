<UserControl x:Class="KcsPdfSigner.App.Tools.ExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" Margin="12,4,12,12">
            <TextBlock x:Name="NoDocumentText" Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Text="Open a PDF to export it." />

            <StackPanel x:Name="Sections">
                <TextBlock Text="Pages as images" Style="{StaticResource SectionHeading}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Format" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="FormatBox" Grid.Column="1" SelectedIndex="0">
                        <ComboBoxItem Content="PNG" />
                        <ComboBoxItem Content="JPG" />
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="DPI" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBox x:Name="DpiBox" Grid.Column="3" Text="150" />
                </Grid>
                <TextBlock Text="Pages (blank = all, e.g. 1-3, 5)" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <TextBox x:Name="PagesBox" />
                <TextBlock Text="Folder" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Margin="6,0,0,0" Click="OnBrowseFolder" />
                    <TextBox x:Name="FolderBox" />
                </DockPanel>
                <Button Content="Export images" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="14,5"
                        Click="OnExportImages" />

                <TextBlock Text="Text" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}" Text="Writes the text of every page to a UTF-8 .txt file." />
                <Button Content="Export text..." Margin="0,8,0,0" HorizontalAlignment="Left" Padding="14,5"
                        Click="OnExportText" />

                <TextBlock Text="Reduce file size" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="Rewrites the document with full compression and drops unused objects. Ctrl+Z undoes it." />
                <TextBlock x:Name="SizeText" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Button Content="Optimize" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="14,5"
                        Click="OnOptimize" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
