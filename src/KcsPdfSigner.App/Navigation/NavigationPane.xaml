<UserControl x:Class="KcsPdfSigner.App.Navigation.NavigationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl x:Name="Tabs" BorderThickness="0,1,0,0">

        <!-- Pages -->
        <TabItem ToolTip="Pages" Padding="9,5">
            <TabItem.Header>
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thumbnails}" />
            </TabItem.Header>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Pages" Style="{StaticResource PaneTitle}" Margin="10,8,10,4" />
                <ListBox x:Name="ThumbList" BorderThickness="0" HorizontalContentAlignment="Center"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnThumbSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6">
                                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="1"
                                        Background="{StaticResource Brush.Wash}" HorizontalAlignment="Center"
                                        Width="{Binding Width}" Height="{Binding Height}">
                                    <Image Source="{Binding Image}" Stretch="Fill" />
                                </Border>
                                <TextBlock Text="{Binding PageNumber}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- Bookmarks -->
        <TabItem ToolTip="Bookmarks" Padding="9,5">
            <TabItem.Header>
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Bookmark}" />
            </TabItem.Header>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Bookmarks" Style="{StaticResource PaneTitle}" Margin="10,8,10,4" />
                <TextBlock x:Name="BookmarksEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="10,0,10,6" />
                <TreeView x:Name="BookmarkTree" BorderThickness="0" SelectedItemChanged="OnBookmarkSelected">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </TabItem>

        <!-- Signatures -->
        <TabItem ToolTip="Signatures" Padding="9,5">
            <TabItem.Header>
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Shield}" />
            </TabItem.Header>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Signatures" Style="{StaticResource PaneTitle}" Margin="10,8,10,4" />
                <TextBlock x:Name="SignaturesEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="10,0,10,6" />
                <ListBox x:Name="SignatureList" BorderThickness="0" SelectionChanged="OnNavItemSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- Comments -->
        <TabItem ToolTip="Comments" Padding="9,5">
            <TabItem.Header>
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Comment}" />
            </TabItem.Header>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Comments" Style="{StaticResource PaneTitle}" Margin="10,8,10,4" />
                <TextBlock x:Name="CommentsEmpty" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="10,0,10,6" />
                <ListBox x:Name="CommentList" BorderThickness="0" SelectionChanged="OnNavItemSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
